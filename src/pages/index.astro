---
import { loadSiteManifest } from "../core/content-loader";

export const prerender = true;

const site = loadSiteManifest();
const defaultModule = site.modules.find(
  (module) => module.id === site.defaultModule,
) ?? site.modules[0];

if (!defaultModule) {
  throw new Error(`没有可用的模块`);
}

// postbuild.mjs will copy defaultModule/index.html to dist/index.html
// so the root URL serves the default module directly without a redirect page.
return Astro.redirect(defaultModule.href);
---

