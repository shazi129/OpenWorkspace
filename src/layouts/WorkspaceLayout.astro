---
import DirectoryTree from "../components/DirectoryTree.astro";
import ModuleNavigation from "../components/ModuleNavigation.astro";
import WorkspaceUpdateClient from "../components/WorkspaceUpdateClient.astro";
import type { ModuleManifest, SiteManifest } from "../core/types";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  activeModule: ModuleManifest;
  currentSlug: string;
  pageTitle: string;
  site: SiteManifest;
}

const { activeModule, currentSlug, pageTitle, site } = Astro.props;
const documentTitle = `${pageTitle} · ${site.title}`;
---

<BaseLayout title={documentTitle} description={site.description}>
  <div class="workspace" data-workspace>
    <header class="mobile-header">
      <button
        class="menu-button"
        type="button"
        aria-controls="module-sidebar"
        aria-expanded="false"
        data-drawer-open
      >
        <span aria-hidden="true">☰</span>
        <span class="visually-hidden">打开功能模块</span>
      </button>
      <strong>{activeModule.title}</strong>
    </header>

    <aside class="module-sidebar" id="module-sidebar" data-drawer>
      <div class="mobile-sidebar-heading">
        <strong>{site.title}</strong>
        <button type="button" aria-label="关闭功能模块" data-drawer-close>×</button>
      </div>
      <ModuleNavigation
        modules={site.modules}
        activeModuleId={activeModule.id}
      />
    </aside>

    <button
      class="drawer-backdrop"
      type="button"
      aria-label="关闭功能模块"
      tabindex="-1"
      data-drawer-close
    ></button>

    <main
      class:list={[
        "workspace-main",
        { "has-directory-tree": activeModule.showDirectoryTree },
      ]}
      data-workspace-main
    >
      {
        activeModule.showDirectoryTree && (
          <div class="directory-region" data-directory-region>
            <aside
              class="directory-sidebar"
              id="directory-tree"
              aria-label={`${activeModule.title}目录`}
              data-directory-sidebar
              data-directory-module={activeModule.id}
            >
              <DirectoryTree nodes={activeModule.tree} currentSlug={currentSlug} />
            </aside>
            <div
              class="directory-resizer"
              role="separator"
              aria-label="调整目录树宽度"
              aria-controls="directory-tree"
              aria-orientation="vertical"
              aria-valuemin="180"
              aria-valuemax="600"
              aria-valuenow="260"
              tabindex="0"
              data-directory-resizer
            ></div>
            <button
              class="directory-toggle"
              type="button"
              aria-label="收起目录树"
              aria-controls="directory-tree"
              aria-expanded="true"
              title="收起目录树"
              data-directory-toggle
            ></button>
          </div>
        )
      }

      <section class="content-panel">
        <slot />
      </section>
    </main>
  </div>

  <WorkspaceUpdateClient />

  <script>
    const workspaces = document.querySelectorAll<HTMLElement>("[data-workspace]");

    for (const workspace of workspaces) {
      const openButton = workspace.querySelector<HTMLButtonElement>("[data-drawer-open]");
      const closeButtons = workspace.querySelectorAll<HTMLButtonElement>("[data-drawer-close]");
      let touchStartX: number | undefined;
      let touchStartY: number | undefined;

      const setDrawerOpen = (open: boolean) => {
        workspace.classList.toggle("drawer-open", open);
        openButton?.setAttribute("aria-expanded", String(open));
        document.body.classList.toggle("drawer-lock", open);
      };

      openButton?.addEventListener("click", () => setDrawerOpen(true));
      closeButtons.forEach((button) =>
        button.addEventListener("click", () => setDrawerOpen(false)),
      );

      workspace.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "mouse" || event.clientX > 24) return;
        touchStartX = event.clientX;
        touchStartY = event.clientY;
      });

      workspace.addEventListener("pointerup", (event) => {
        if (touchStartX === undefined || touchStartY === undefined) return;
        const horizontalDistance = event.clientX - touchStartX;
        const verticalDistance = Math.abs(event.clientY - touchStartY);
        if (horizontalDistance > 64 && horizontalDistance > verticalDistance) {
          setDrawerOpen(true);
        }
        touchStartX = undefined;
        touchStartY = undefined;
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setDrawerOpen(false);
      });

      const directoryMain = workspace.querySelector<HTMLElement>(
        "[data-workspace-main]",
      );
      const directoryRegion = workspace.querySelector<HTMLElement>(
        "[data-directory-region]",
      );
      const directorySidebar = workspace.querySelector<HTMLElement>(
        "[data-directory-sidebar]",
      );
      const directoryResizer = workspace.querySelector<HTMLElement>(
        "[data-directory-resizer]",
      );
      const directoryToggle = workspace.querySelector<HTMLButtonElement>(
        "[data-directory-toggle]",
      );

      if (
        directoryMain &&
        directoryRegion &&
        directorySidebar &&
        directoryResizer &&
        directoryToggle
      ) {
        const minimumWidth = 180;
        const defaultWidth = 260;
        const widthStorageKey = "openworkspace.directoryTree.width";
        const collapsedStorageKey = "openworkspace.directoryTree.collapsed";
        const navigationStorageKey = "openworkspace.directoryTree.navigation";
        let directoryWidth = defaultWidth;
        let resizingPointer: number | undefined;

        const directoryDetails = Array.from(
          directorySidebar.querySelectorAll<HTMLDetailsElement>(
            "details[data-directory-slug]",
          ),
        );
        const moduleId = directorySidebar.dataset.directoryModule;

        try {
          const storedNavigation = window.sessionStorage.getItem(
            navigationStorageKey,
          );
          window.sessionStorage.removeItem(navigationStorageKey);
          if (storedNavigation) {
            const navigation = JSON.parse(storedNavigation) as {
              moduleId?: string;
              openSlugs?: string[];
            };
            if (
              navigation.moduleId === moduleId &&
              Array.isArray(navigation.openSlugs)
            ) {
              const openSlugs = new Set(navigation.openSlugs);
              directoryDetails.forEach((details) => {
                details.open = openSlugs.has(details.dataset.directorySlug ?? "");
              });
            }
          }
        } catch {
          // 无法使用会话存储时，保留服务端根据当前 URL 生成的默认展开状态。
        }

        directorySidebar.addEventListener("click", (event) => {
          if (
            !(event instanceof MouseEvent) ||
            event.button !== 0 ||
            event.ctrlKey ||
            event.metaKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }

          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest<HTMLAnchorElement>("a[data-directory-link]");
          if (!link || !moduleId) return;

          try {
            window.sessionStorage.setItem(
              navigationStorageKey,
              JSON.stringify({
                moduleId,
                openSlugs: directoryDetails
                  .filter((details) => details.open)
                  .map((details) => details.dataset.directorySlug),
              }),
            );
          } catch {
            // 无法使用会话存储时，导航仍按默认行为继续。
          }
        });

        const readStoredValue = (key: string) => {
          try {
            return window.localStorage.getItem(key);
          } catch {
            return null;
          }
        };

        const storeValue = (key: string, value: string) => {
          try {
            window.localStorage.setItem(key, value);
          } catch {
            // 浏览器禁用本地存储时，交互仍在当前页面内生效。
          }
        };

        const maximumWidth = () =>
          Math.max(minimumWidth, Math.min(600, directoryMain.clientWidth - 320));

        const setDirectoryWidth = (width: number, persist = false) => {
          directoryWidth = Math.round(
            Math.min(maximumWidth(), Math.max(minimumWidth, width)),
          );
          directoryMain.style.setProperty(
            "--directory-width",
            `${directoryWidth}px`,
          );
          directoryResizer.setAttribute("aria-valuenow", String(directoryWidth));
          directoryResizer.setAttribute("aria-valuemax", String(maximumWidth()));
          if (persist) storeValue(widthStorageKey, String(directoryWidth));
        };

        const setDirectoryCollapsed = (collapsed: boolean, persist = false) => {
          directoryMain.classList.toggle("directory-collapsed", collapsed);
          directorySidebar.toggleAttribute("hidden", collapsed);
          directoryResizer.toggleAttribute("hidden", collapsed);
          directoryResizer.tabIndex = collapsed ? -1 : 0;
          directoryToggle.setAttribute("aria-expanded", String(!collapsed));
          const label = collapsed ? "展开目录树" : "收起目录树";
          directoryToggle.setAttribute("aria-label", label);
          directoryToggle.title = label;
          if (persist) storeValue(collapsedStorageKey, String(collapsed));
        };

        const storedWidth = Number.parseInt(
          readStoredValue(widthStorageKey) ?? "",
          10,
        );
        setDirectoryWidth(
          Number.isFinite(storedWidth) ? storedWidth : defaultWidth,
        );
        setDirectoryCollapsed(
          readStoredValue(collapsedStorageKey) === "true",
        );

        directoryToggle.addEventListener("click", () => {
          const collapsed = !directoryMain.classList.contains(
            "directory-collapsed",
          );
          setDirectoryCollapsed(collapsed, true);
        });

        const resizeFromPointer = (clientX: number) => {
          const mainLeft = directoryMain.getBoundingClientRect().left;
          setDirectoryWidth(clientX - mainLeft);
        };

        const stopResizing = (pointerId: number) => {
          if (resizingPointer !== pointerId) return;
          resizingPointer = undefined;
          document.body.classList.remove("directory-resizing");
          storeValue(widthStorageKey, String(directoryWidth));
        };

        directoryResizer.addEventListener("pointerdown", (event) => {
          if (event.button !== 0) return;
          resizingPointer = event.pointerId;
          directoryResizer.setPointerCapture(event.pointerId);
          document.body.classList.add("directory-resizing");
          resizeFromPointer(event.clientX);
          event.preventDefault();
        });

        directoryResizer.addEventListener("pointermove", (event) => {
          if (resizingPointer !== event.pointerId) return;
          resizeFromPointer(event.clientX);
        });

        directoryResizer.addEventListener("pointerup", (event) => {
          stopResizing(event.pointerId);
        });

        directoryResizer.addEventListener("pointercancel", (event) => {
          stopResizing(event.pointerId);
        });

        directoryResizer.addEventListener("lostpointercapture", (event) => {
          stopResizing(event.pointerId);
        });

        directoryResizer.addEventListener("keydown", (event) => {
          let nextWidth = directoryWidth;
          if (event.key === "ArrowLeft") nextWidth -= 16;
          else if (event.key === "ArrowRight") nextWidth += 16;
          else if (event.key === "Home") nextWidth = minimumWidth;
          else if (event.key === "End") nextWidth = maximumWidth();
          else return;

          setDirectoryWidth(nextWidth, true);
          event.preventDefault();
        });

        window.addEventListener("resize", () => {
          setDirectoryWidth(directoryWidth);
        });
      }
    }
  </script>
</BaseLayout>
