---
const rebuildEndpoint =
  import.meta.env.PUBLIC_REBUILD_ENDPOINT ??
  "/openworkspace-admin/rebuild";
---

<span
  hidden
  data-workspace-update-config
  data-rebuild-endpoint={rebuildEndpoint}
></span>

<script>
  const config = document.querySelector<HTMLElement>(
    "[data-workspace-update-config]",
  );
  const endpoint = config?.dataset.rebuildEndpoint;
  const tokenStorageKey = "openworkspace.rebuild.token";
  const controls = document.querySelectorAll<HTMLElement>(
    "[data-workspace-update]",
  );

  for (const control of controls) {
    const updateButton = control.querySelector<HTMLButtonElement>(
      "[data-workspace-update-button]",
    );
    const status = control.querySelector<HTMLElement>(
      "[data-workspace-update-status]",
    );
    if (!updateButton || !status || !endpoint) continue;

    updateButton.addEventListener("click", async () => {
      let token = window.sessionStorage.getItem(tokenStorageKey);
      if (!token) {
        token = window.prompt("请输入更新令牌")?.trim() ?? "";
        if (!token) return;
        window.sessionStorage.setItem(tokenStorageKey, token);
      }

      updateButton.disabled = true;
      updateButton.textContent = "正在更新…";
      status.textContent = "正在拉取最新 Git 内容并执行生产构建，请稍候。";

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { Authorization: `Bearer ${token}` },
        });
        const result = (await response.json().catch(() => ({}))) as {
          error?: string;
        };

        if (response.status === 401) {
          window.sessionStorage.removeItem(tokenStorageKey);
        }
        if (!response.ok) {
          throw new Error(result.error ?? `请求失败（${response.status}）`);
        }

        status.textContent = "更新完成，即将刷新页面。";
        window.setTimeout(() => window.location.reload(), 800);
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "更新失败";
        updateButton.disabled = false;
        updateButton.textContent = "更新";
      }
    });
  }
</script>
