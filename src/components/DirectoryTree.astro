---
import type { ContentTreeNode } from "../core/types";
import DirectoryTree from "./DirectoryTree.astro";

interface Props {
  currentSlug: string;
  nodes: ContentTreeNode[];
}

const { currentSlug, nodes } = Astro.props;
---

<ul class="directory-list">
  {
    nodes.map((node) => {
      if (node.kind === "directory") {
        const containsCurrent =
          currentSlug === node.slug || currentSlug.startsWith(`${node.slug}/`);

        return (
          <li class="directory-node">
            <details open={containsCurrent} data-directory-slug={node.slug}>
              <summary title={node.label}>
                <span class="tree-node-icon folder-icon" aria-hidden="true">
                  <svg viewBox="0 0 20 20" focusable="false">
                    <path
                      fill="currentColor"
                      d="M2.5 4.25C2.5 3.56 3.06 3 3.75 3h3.1c.4 0 .78.19 1.02.52l.86 1.18h7.52c.69 0 1.25.56 1.25 1.25v8.8c0 .69-.56 1.25-1.25 1.25H3.75c-.69 0-1.25-.56-1.25-1.25V4.25Z"
                    ></path>
                  </svg>
                </span>
                <span class="tree-node-label">{node.label}</span>
              </summary>
              <DirectoryTree
                nodes={node.children ?? []}
                currentSlug={currentSlug}
              />
            </details>
          </li>
        );
      }

      return (
        <li class="file-node">
          <a
            href={node.href}
            data-directory-link
            aria-current={node.slug === currentSlug ? "page" : undefined}
            title={node.label}
          >
            <span class="tree-node-icon file-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none" focusable="false">
                <path
                  d="M5 2.75h6.25L15.5 7v10.25H5V2.75Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                ></path>
                <path
                  d="M11.25 2.75V7h4.25M7.5 10h5.5M7.5 13h5.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
              </svg>
            </span>
            <span class="tree-node-label">{node.label}</span>
          </a>
        </li>
      );
    })
  }
</ul>
