---
import type { ModuleManifest } from "../core/types";

interface Props {
  activeModuleId: string;
  modules: ModuleManifest[];
}

const { activeModuleId, modules } = Astro.props;
const visibleModules = modules.filter((module) => !module.private);
const firstBottomModuleIndex = visibleModules.findIndex(
  (module) => module.order < 0,
);
---

<nav class="module-navigation" aria-label="功能模块">
  <ul>
    {
      visibleModules.map((module, index) => (
        <li
          class:list={{
            "module-bottom-start": index === firstBottomModuleIndex,
          }}
        >
          <a
            class="module-link"
            href={module.href}
            aria-current={module.id === activeModuleId ? "page" : undefined}
          >
            <img
              class="module-icon"
              src={module.iconUrl}
              alt=""
              width="38"
              height="38"
            />
            <span>{module.title}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
