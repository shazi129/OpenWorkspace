---
const rebuildEndpoint =
  import.meta.env.PUBLIC_REBUILD_ENDPOINT ??
  "/openworkspace-admin/rebuild";
---

<div
  class="toolbar-settings"
  data-settings-control
  data-rebuild-endpoint={rebuildEndpoint}
>
  <button
    class="settings-toggle"
    type="button"
    aria-controls="settings-panel"
    aria-expanded="false"
    data-settings-toggle
  >
    <svg
      class="settings-icon"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M12 15.25A3.25 3.25 0 1 0 12 8.75a3.25 3.25 0 0 0 0 6.5Z"
        stroke="currentColor"
        stroke-width="1.7"
      ></path>
      <path
        d="m19.1 13.4 1.15 1.8-2 3.05-2.1-.55a8.7 8.7 0 0 1-1.7 1l-.55 2.05h-3.8l-.55-2.05a8.7 8.7 0 0 1-1.7-1l-2.1.55-2-3.05 1.15-1.8a8.5 8.5 0 0 1 0-2.8L3.75 8.8l2-3.05 2.1.55a8.7 8.7 0 0 1 1.7-1l.55-2.05h3.8l.55 2.05a8.7 8.7 0 0 1 1.7 1l2.1-.55 2 3.05-1.15 1.8a8.5 8.5 0 0 1 0 2.8Z"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.7"
      ></path>
    </svg>
    <span>设置</span>
  </button>

  <section
    class="settings-panel"
    id="settings-panel"
    aria-label="设置"
    hidden
    data-settings-panel
  >
    <strong>设置</strong>
    <button class="rebuild-button" type="button" data-rebuild-button>
      重新生成
    </button>
    <p class="settings-status" role="status" aria-live="polite" data-rebuild-status>
      拉取最新 Git 内容并重新构建站点。
    </p>
  </section>
</div>

<script>
  const controls = document.querySelectorAll<HTMLElement>(
    "[data-settings-control]",
  );
  const tokenStorageKey = "openworkspace.rebuild.token";

  for (const control of controls) {
    const toggle = control.querySelector<HTMLButtonElement>(
      "[data-settings-toggle]",
    );
    const panel = control.querySelector<HTMLElement>("[data-settings-panel]");
    const rebuildButton = control.querySelector<HTMLButtonElement>(
      "[data-rebuild-button]",
    );
    const status = control.querySelector<HTMLElement>("[data-rebuild-status]");
    const endpoint = control.dataset.rebuildEndpoint;

    if (!toggle || !panel || !rebuildButton || !status || !endpoint) continue;

    const setPanelOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () =>
      setPanelOpen(panel.hasAttribute("hidden")),
    );

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (target instanceof Node && !control.contains(target)) {
        setPanelOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        setPanelOpen(false);
        toggle.focus();
      }
    });

    rebuildButton.addEventListener("click", async () => {
      let token = window.sessionStorage.getItem(tokenStorageKey);
      if (!token) {
        token = window.prompt("请输入重新生成令牌")?.trim() ?? "";
        if (!token) return;
        window.sessionStorage.setItem(tokenStorageKey, token);
      }

      rebuildButton.disabled = true;
      rebuildButton.textContent = "正在重新生成…";
      status.textContent = "正在拉取最新 Git 内容并执行生产构建，请稍候。";

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          headers: { Authorization: `Bearer ${token}` },
        });
        const result = (await response.json().catch(() => ({}))) as {
          error?: string;
        };

        if (response.status === 401) {
          window.sessionStorage.removeItem(tokenStorageKey);
        }
        if (!response.ok) {
          throw new Error(result.error ?? `请求失败（${response.status}）`);
        }

        status.textContent = "重新生成完成，即将刷新页面。";
        window.setTimeout(() => window.location.reload(), 800);
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : "重新生成失败";
        rebuildButton.disabled = false;
        rebuildButton.textContent = "重新生成";
      }
    });
  }
</script>
