[Unit]
Description=OpenWorkspace private API
After=network.target

[Service]
Type=simple
User=openworkspace
WorkingDirectory=/opt/openworkspace
EnvironmentFile=/etc/openworkspace/api.env
ExecStart=/usr/bin/npm run api
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
